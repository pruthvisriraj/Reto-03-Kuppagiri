# LLM provider: "anthropic" (production) or "offline" (scripted test double, no key needed)
LLM_PROVIDER=anthropic
# Anthropic API key. Backend only. Never commit a real value.
ANTHROPIC_API_KEY=
# Model id sent to the provider
LLM_MODEL=claude-sonnet-5
# Timeout for each provider call, in milliseconds
LLM_TIMEOUT_MS=45000
# Max output tokens per provider call
LLM_MAX_OUTPUT_TOKENS=2048

# Agent loop limits
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=300000
# Ceiling across all sessions per UTC day, so a public link cannot drain the key
MAX_TOKENS_PER_DAY=2000000

# HTTP server
PORT=3000
# Optional shared key for the public link. Empty = open link.
ACCESS_KEY=
# Requests per minute per client IP on /api/chat
RATE_LIMIT_PER_MIN=20
# Set to true behind a reverse proxy (Render, Railway, Fly) so rate limiting uses X-Forwarded-For
TRUST_PROXY=false
